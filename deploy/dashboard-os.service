# Generated automatically by `./start enable` with correct User + path.
# Manual install is no longer needed — prefer:
#   ./start enable
#
# Fallback template (edit User / WorkingDirectory if you copy by hand):
[Unit]
Description=Dashboard OS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/dashboard-os
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=384
Environment=DASHBOARD_PI=1
Environment=PORT=3000
Environment=HOST=0.0.0.0
ExecStart=/home/pi/dashboard-os/start
Restart=on-failure
RestartSec=5
MemoryMax=600M
MemoryHigh=450M

[Install]
WantedBy=multi-user.target
